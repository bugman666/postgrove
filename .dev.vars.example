# Copy to `.dev.vars` for local Wrangler secrets.
# `.dev.vars` is gitignored. Do not commit real credentials.
#
# Local login (after `cp .dev.vars.example .dev.vars` and `npm run dev`):
#   curl -c /tmp/pg-cookies -X POST http://127.0.0.1:8787/auth/login \
#     -H 'content-type: application/json' \
#     -d '{"address":"inbox@example.test","token":"change-me-local-owner-token"}'
#   curl -b /tmp/pg-cookies http://127.0.0.1:8787/auth/session
#   curl -H 'Authorization: Bearer change-me-local-admin-token' \
#     http://127.0.0.1:8787/admin/ping
#   curl -H 'Authorization: Bearer change-me-local-admin-token' \
#     http://127.0.0.1:8787/admin/users
# Member login (seeded grove / empty@example.test):
#   curl -c /tmp/pg-user -X POST http://127.0.0.1:8787/auth/login \
#     -H 'content-type: application/json' \
#     -d '{"address":"empty@example.test","token":"change-me-local-user-token"}'
#
# Production: `npx wrangler secret put SESSION_SECRET` (and OWNER_TOKEN, ADMIN_TOKEN,
# plus RESEND_API_KEY when OUTBOUND_PROVIDER=resend).
# Do not reuse these placeholders remotely.
# Runbook: docs/PRODUCTION_AUTH.md
#
# OWNER_TOKEN is one shared secret for every mailbox — not a per-address password.
# Anyone who has it can open any active address. It is break-glass / deploy owner
# only. Production day-to-day: member tokens + admin (POST /admin/users), not a
# shared operator password. Members get their own token (shown once).
# ADMIN_TOKEN (or an admin-role member session) opens /admin.
# GET /healthz and /admin/ping may include auth_mode=owner_break_glass when the
# users table has no members (non-breaking hint).
#
# Rotate / revoke (sessions are stateless HMAC — logout only clears that browser):
#   SESSION_SECRET  — put a new value and redeploy to drop every cookie.
#                     Also re-rotate inbound hook secrets (envelopes use this key).
#   OWNER_TOKEN     — new value + redeploy. Does not drop cookies; rotate
#                     SESSION_SECRET too if the owner token leaked.
#   ADMIN_TOKEN     — same as OWNER_TOKEN. Rotate SESSION_SECRET if an admin
#                     cookie may have been copied.
#   Member token    — mint a replacement; disable the user to stop the next
#                     request. Rotate SESSION_SECRET to drop an issued cookie.
#   REST pg_ token  — mint a new hash row; delete the old one.
#
# POST /auth/login is limited to 8 attempts per 10 minutes per IP. A 429
# includes a human-readable hint and Retry-After. REST / signup use the same
# limiter (`src/rate-limit.ts`). Bind Workers KV as RATE_LIMIT in wrangler.jsonc
# so isolates share the window (`npx wrangler kv namespace create RATE_LIMIT`).
# Without the binding, counters stay in-memory per isolate (local / tests).

# HMAC secret for the owner session cookie (min 16 characters). Rotate to revoke sessions.
SESSION_SECRET=change-me-local-session-secret

# Shared mailbox-owner token for POST /auth/login (min 8 characters).
# Not a per-address password: any active mailbox plus this token issues a session.
OWNER_TOKEN=change-me-local-owner-token

# Admin bearer token for /admin/* (Authorization: Bearer …, min 8 characters).
ADMIN_TOKEN=change-me-local-admin-token

# Outbound send. stub records attempts in D1 and does not leave the box.
# resend needs RESEND_API_KEY. http needs OUTBOUND_HTTP_URL.
# Unset / incomplete real providers fail loud on send (no silent drop).
OUTBOUND_PROVIDER=stub

# Required when OUTBOUND_PROVIDER=resend.
# RESEND_API_KEY=
# Optional From override (must be a domain verified in Resend).
# RESEND_FROM=

# Alternative: OUTBOUND_PROVIDER=http
# POST JSON { from, to, subject, text } to this URL.
# OUTBOUND_HTTP_URL is operator-trusted only (env / wrangler secret).
# Do not accept it from the UI. The http adapter does not run validateSafeUrl
# on this env value (trusted private hooks must keep working).
# If a Settings field lands, call assertOutboundHttpUrl(raw) before save.
# Optional: OUTBOUND_HTTP_STRICT=1 fails loud at adapter resolve when the
# env URL is localhost / metadata / RFC1918. Default off.
# OUTBOUND_HTTP_URL=
# OUTBOUND_HTTP_TOKEN=
# OUTBOUND_HTTP_STRICT=0

# Optional From override for any provider (wins over RESEND_FROM).
# OUTBOUND_FROM=

# Inbound attachment caps (also set as wrangler.jsonc vars; override here if needed).
# Defaults: 10 MiB per file, 10 files per message. Over-limit inbound is rejected
# with a human-readable reason. Outbound compose attachments are a later follow-up.
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_COUNT=10

# Open REST (/api/v1). Mint mailbox-scoped tokens with an owner session
# (POST /api/tokens) or admin (POST /admin/tokens). Authorization: Bearer pg_…
# Tokens are hashed at rest. The plaintext secret is shown once.
#
# Public signup (POST /api/v1/public/signup) stays disabled until both
# Turnstile keys are set. The Worker POSTs secret + response to
# https://challenges.cloudflare.com/turnstile/v0/siteverify.
# TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
#
# Defaults. Shared across isolates when RATE_LIMIT KV is bound; otherwise
# in-memory per isolate. Over limit → 429 / 413.
# REST_RATE_LIMIT_MAX=60
# REST_RATE_LIMIT_WINDOW_MS=60000
# SIGNUP_RATE_LIMIT_MAX=5
# SIGNUP_RATE_LIMIT_WINDOW_MS=600000
# REST_BODY_MAX_BYTES=256000
#
# Per-token daily quotas (D1). 0 = unlimited. Applied as the mint default
# when the request does not set quota_requests_daily / quota_send_daily.
# Over limit → 429 quota_api / quota_send.
# REST_QUOTA_REQUESTS_DAILY=0
# REST_QUOTA_SEND_DAILY=0
#
# Plus-tag: mail to user+tag@the-mailbox-domain lands in user@domain.
# Settings / POST /api/v1/aliases can list generated aliases (own domain only).
#
# Inbound webhooks / forward (#11). Default: https only; validateSafeUrl on
# save, fetch, and each redirect. webhook_secret is stored enveloped
# (enc:v1:, key from SESSION_SECRET); mint/rotate shows plaintext once.
# Leftover plaintext rows wrap on next read/save; rotate after SESSION_SECRET change.
# Set to 1 for local http://127.0.0.1 hooks.
# ALLOW_PRIVATE_WEBHOOKS=0
#
# Dev inbox API (/api/v1/dev/inboxes). Own domain only — not a public
# temp-mail pool. Tokens mint short-lived addresses on their mailbox domain
# (or MAIL_DOMAIN when set). +tag aliases are a separate surface.
# MAIL_DOMAIN=example.test
# DEV_INBOX_QUOTA=8
# DEV_INBOX_TTL_SECONDS=900
# DEV_INBOX_TTL_MAX_SECONDS=3600
# DEV_WAIT_MAX_MS=20000
