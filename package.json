{
  "name": "postgrove",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply postgrove --local",
    "db:seed:local": "wrangler d1 execute postgrove --local --file=scripts/seed-local.sql",
    "r2:seed:local": "wrangler r2 object put postgrove-attachments-local/attachments/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222224/33333333-3333-4333-8333-333333333331/grove-note.txt --file=scripts/seed-grove-note.txt --local",
    "seed:local": "npm run db:seed:local && npm run r2:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply postgrove --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
