{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postgrove",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  // Replace the database_id after `npx wrangler d1 create postgrove`.
  // Local `wrangler dev` and `--local` migrations use preview_database_id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "postgrove",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "postgrove-local",
      "migrations_dir": "migrations"
    }
  ],
  // Replace bucket_name after `npx wrangler r2 bucket create postgrove-attachments`.
  // Local `wrangler dev` uses preview_bucket_name.
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "postgrove-attachments",
      "preview_bucket_name": "postgrove-attachments-local"
    }
  ],
  // Shared login / REST / signup counters. Replace id after:
  //   npx wrangler kv namespace create RATE_LIMIT
  // Local `wrangler dev` uses preview_id (or `npx wrangler kv namespace create RATE_LIMIT --preview`).
  // If the binding is missing, the Worker keeps the in-memory Map.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "00000000-0000-0000-0000-000000000000",
      "preview_id": "postgrove-rate-limit-local"
    }
  ],
  "vars": {
    "ATTACHMENT_MAX_BYTES": "10485760",
    "ATTACHMENT_MAX_COUNT": "10"
  }
}
